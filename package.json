{
  "name": "asset-passport",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <24.17.0 || >=24.18.0 <26.3.1 || >=26.4.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "lint:fix": "eslint . --fix --ext .js,.mjs,.cjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npx @cognite/cli@latest apps deploy --interactive",
    "activate": "npx @cognite/cli@latest apps activate --interactive",
    "setup-https": "npx @cognite/cli@latest apps setup-https"
  },
  "dependencies": {
    "@cognite/app-sdk": "^0.9.0",
    "@cognite/aura": "^1.46104.0",
    "@cognite/sdk": "^10.10.0",
    "@adnoc/agent-mascot": "*",
    "@flows/trend-chart": "*",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.25",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.2.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": ">=5.1.1 <6.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.46.4",
    "vite": ">=7.3.5 <8.0.0",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "packages/*"
  ]
}
